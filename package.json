{
  "name": "airplane-radar-widget",
  "version": "1.3.2",
  "description": "Radar de aviões em tempo real com Electron e OpenSky.",
  "main": "src/js/Main.js",
  "author": "BadPineapple",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.renato.airplaneradar",
    "productName": "Airplane Radar Widget",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "config/*",
      "!dist/**/*"
    ],
    "extraResources": [
      {
        "from": "assets/sound/",
        "to": "sound"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/img/icon.ico"
    }
  },
  "dependencies": {
    "@electron/remote": "^2.1.2",
    "auto-launch": "^5.0.5",
    "dotenv": "^16.5.0",
    "node-fetch": "^2.6.7"
  },
  "devDependencies": {
    "electron": "^28.2.3",
    "electron-builder": "^24.13.2"
  }
}
