{
  "name": "airplane-radar-widget",
  "version": "1.4.1",
  "description": "Radar de aviões em tempo real com Electron e OpenSky (Refatorado).",
  "main": "src/js/Main.js",
  "author": "BadPineapple",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "dist": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.renato.airplaneradar",
    "productName": "Airplane Radar Widget",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "!config/**/*",
      "!logs/**/*",
      "!dist/**/*",
      "!**/*.map",
      "!**/.env*"
    ],
    "extraResources": [
      {
        "from": "assets/sound/",
        "to": "sound"
      },
      {
        "from": "config/TechnicalData.json",
        "to": "TechnicalData.json"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/img/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "@electron/remote": "^2.1.2",
    "auto-launch": "^5.0.6"
  },
  "devDependencies": {
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1"
  }
}